# Gere APP_SECRET e credenciais com php tools/initialize.php
APP_SECRET=
APP_USERNAME=admin
APP_PASSWORD_HASH=

# Compatibilidade com o add-on original de instância única (opcional): http://192.168.1.50:19133
BEDROCK_API_URL=
# Use o mesmo rcon_token definido no add-on. Nas instâncias abaixo, referencie com ${BEDROCK_API_TOKEN}.
BEDROCK_API_TOKEN=

# Lista privada de instâncias: id/nome e endereço da API correspondente à posição na lista do add-on.
# O token da API não é enviado ao navegador. Nunca publique o arquivo .env.
BEDROCK_INSTANCES='[{"id":"main","name":"Abydos","url":"http://192.168.1.50:19233","token":"${BEDROCK_API_TOKEN}"}]'

APP_TIMEZONE=America/Sao_Paulo
LOG_RETENTION_DAYS=7
